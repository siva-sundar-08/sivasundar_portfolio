# Public URL of the deployed site. Used for metadata, canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://example.com

# FormSubmit target for the contact form: your email address, or (better) the random
# alias FormSubmit gives you after the first activation email. Never exposed to the browser.
# Leave empty in development to log messages to the terminal instead of sending them.
CONTACT_FORMSUBMIT_ID=
